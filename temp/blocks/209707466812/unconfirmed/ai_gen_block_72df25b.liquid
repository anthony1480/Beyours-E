{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr);
    min-height: 520px;
  }

  .ai-editorial-{{ ai_gen_id }}__media {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    background: {{ block.settings.image_background }};
  }

  .ai-editorial-{{ ai_gen_id }}__media img,
  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: {{ block.settings.muted_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__empty {
    position: absolute;
    right: 20px;
    bottom: 20px;
    left: 20px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, .9);
    color: {{ block.settings.muted_color }};
    font-size: 12px;
    letter-spacing: .08em;
    text-align: center;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 6vw, 88px) clamp(24px, 6vw, 84px);
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 22px;
    color: {{ block.settings.accent_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__heading {
    max-width: 620px;
    margin: 0 0 24px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, sans-serif;
    font-size: clamp(34px, 4.5vw, 70px);
    font-weight: 600;
    letter-spacing: -.04em;
    line-height: .98;
  }

  .ai-editorial-{{ ai_gen_id }}__body {
    max-width: 500px;
    margin: 0 0 30px;
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 16px;
    line-height: 1.7;
  }

  .ai-editorial-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    border-bottom: 1px solid {{ block.settings.text_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .08em;
    padding-bottom: 8px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 5px;
  }

  .ai-editorial-{{ ai_gen_id }}__link span {
    font-size: 18px;
    line-height: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }}__inner {
      grid-template-columns: 1fr;
    }

    .ai-editorial-{{ ai_gen_id }}__media {
      min-height: 390px;
    }

    .ai-editorial-{{ ai_gen_id }}__content {
      padding: 42px 24px 48px;
    }
  }
{% endstyle %}

<div class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-{{ ai_gen_id }}__inner">
    <div class="ai-editorial-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-editorial-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
        <div class="ai-editorial-{{ ai_gen_id }}__empty">Add an editorial image</div>
      {% endif %}
    </div>
    <div class="ai-editorial-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}<p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-editorial-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}
      {% if block.settings.body != blank %}<div class="ai-editorial-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}
      {% if block.settings.link_label != blank and block.settings.link != blank %}<a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.link }}">{{ block.settings.link_label }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial feature",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The essentials edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A considered approach to everyday care" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Thoughtful formulas, elevated rituals, and a little more time for yourself.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore the edit" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fff8f5" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#f3f3f3" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#212326" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#212326" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#8f3f50" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5f6266" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#1a1b18" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "poppins_n6" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "twentieth_century_n4" }
  ],
  "presets": [
    { "name": "Editorial feature" }
  ],
  "tag": null,
  "class": "editorial-feature-block"
}
{% endschema %}